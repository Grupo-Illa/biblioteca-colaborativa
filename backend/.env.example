DATABASE_URL="postgresql://postgres:postgres@localhost:5432/biblioteca-colab"
DOOR=3001

# Segredo que assina o token de sessao. Gerado com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-aleatorio

# Validade do token de sessao
JWT_EXPIRES_IN=1d

# Origem do frontend liberada no CORS. Precisa ser a origin exata
# (ex.: http://localhost:3000), nunca "*": o navegador descarta o
# cookie de sessao quando o CORS responde com "*".
FRONTEND_URL=http://localhost:3000