generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  USUARIO
  ADMIN
}

enum StatusAluguel {
  DISPONIVEL
  ALUGADO
}

// Situacao de um aluguel individual, diferente do status agregado do livro.
enum StatusEmprestimo {
  ATIVO
  DEVOLVIDO
  VENCIDO
}

model Livro {
  id                Int           @id @default(autoincrement())
  titulo            String        @db.VarChar(255)
  autor             String        @db.VarChar(255)
  dataLancamento    DateTime      @db.Date
  editora           String        @db.VarChar(255)
  statusAluguel     StatusAluguel @default(DISPONIVEL)
  quantidadeTotal   Int           @default(1)
  quantidadeAlugada Int           @default(0)
  criadoEm          DateTime      @default(now())
  atualizadoEm      DateTime      @updatedAt
  emprestimos       Emprestimo[]
  avaliacoes        Avaliacao[]
}

// Cada linha e um exemplar retirado por um usuario. E o que permite bloquear
// o segundo aluguel do mesmo titulo e contar o prazo de devolucao.
model Emprestimo {
  id             Int              @id @default(autoincrement())
  usuarioId      Int
  livroId        Int
  dataAluguel    DateTime         @default(now())
  prazoDevolucao DateTime
  dataDevolucao  DateTime?
  status         StatusEmprestimo @default(ATIVO)
  usuario        Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  livro          Livro            @relation(fields: [livroId], references: [id], onDelete: Cascade)

  @@index([usuarioId, status])
  @@index([livroId, status])
}

// Nota que o usuario deu para um titulo que ele alugou. Uma avaliacao por
// usuario por livro: repetir a nota atualiza a anterior em vez de duplicar.
model Avaliacao {
  id           Int      @id @default(autoincrement())
  usuarioId    Int
  livroId      Int
  nota         Int
  comentario   String?  @db.VarChar(500)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  livro        Livro    @relation(fields: [livroId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, livroId])
  @@index([livroId])
}

model Usuario {
  id             Int          @id @default(autoincrement())
  nomeUsuario    String       @db.VarChar(255)
  senha          String       @db.VarChar(255)
  email          String       @unique @db.VarChar(255)
  dataNascimento DateTime     @db.Date
  perfil         Perfil       @default(USUARIO)
  telefone       String?      @db.VarChar(50)
  criadoEm       DateTime     @default(now())
  atualizadoEm   DateTime     @updatedAt
  emprestimos    Emprestimo[]
  avaliacoes     Avaliacao[]
}
